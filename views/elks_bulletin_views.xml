<?xml version="1.0" encoding="utf-8"?>
<!-- =====================================================================
     === HUMAN ===
     The backend screens: the newsletter list + editing form (with the
     page content area), and the template list/form.
     === AI AGENT ===
     The editing form renders body_arch with widget="mass_mailing_html" (the
     email-designer drag-drop editor); body_html is the inlined copy, kept
     invisible. Header buttons run Preview/Print plus the New Members… /
     In Memoriam… curated-list dialogs. charter_missing drives a warning banner.
     Actions are referenced by the menus file.
     ===================================================================== -->
<odoo>

    <!-- ============== Newsletter Issue: form ============== -->
    <record id="view_elks_bulletin_issue_form" model="ir.ui.view">
        <field name="name">elks.bulletin.issue.form</field>
        <field name="model">elks.bulletin.issue</field>
        <field name="arch" type="xml">
            <form string="Newsletter" class="o_elksbulletin_form">
                <header>
                    <button name="action_preview_html" type="object"
                            string="Preview (data)" class="btn-secondary"
                            icon="fa-bolt"
                            help="Fast HTML preview with real data — no PDF"/>
                    <button name="action_preview_pdf" type="object"
                            string="Preview PDF" class="btn-secondary"
                            icon="fa-eye"/>
                    <button name="action_print_pdf" type="object"
                            string="Print / Download PDF" class="btn-primary"
                            icon="fa-file-pdf-o"/>
                    <button name="action_select_new_members" type="object"
                            string="New Members…" class="btn-secondary"
                            icon="fa-user-plus"
                            help="Choose exactly who appears in the New Members block. Opens pre-filled with the automatic list so you can deselect or add members."/>
                    <button name="action_select_in_memoriam" type="object"
                            string="In Memoriam…" class="btn-secondary"
                            icon="fa-users"
                            help="Choose exactly who appears in the In Memoriam block. Opens pre-filled with the automatic list so you can deselect or add members."/>
                    <button name="action_mark_final" type="object"
                            string="Mark Final"
                            invisible="state == 'final'"
                            groups="elksbulletin.group_elksbulletin_manager"/>
                    <button name="action_reset_draft" type="object"
                            string="Reset to Draft"
                            invisible="state == 'draft'"
                            groups="elksbulletin.group_elksbulletin_manager"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,final"/>
                </header>
                <sheet>
                    <field name="charter_missing" invisible="1"/>
                    <div class="alert alert-warning" role="alert"
                         invisible="not charter_missing">
                        The lodge <b>charter date</b> isn't set in FRS, so the
                        masthead can't show the Volume yet. Set it in the FRS
                        Lodge Settings and it fills in automatically.
                    </div>
                    <div class="oe_title">
                        <h1><field name="name"
                                   placeholder="Lodge Newsletter — Month Year"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="issue_date"/>
                            <field name="page_size"/>
                            <field name="template_id"/>
                            <button name="action_load_template" type="object"
                                    string="Load Template" class="btn-link"
                                    icon="fa-download"
                                    confirm="This replaces the current newsletter content with the selected template. Continue?"
                                    help="Fill the newsletter with the selected template's content (replaces what's there)."/>
                        </group>
                        <group>
                            <field name="issue_ref" readonly="1"/>
                            <field name="lodge_name" readonly="1"/>
                        </group>
                    </group>
                    <group string="Dynamic Block Settings"
                           help="Defaults for the auto-filled New Members block and the curated-list status of New Members / In Memoriam.">
                        <group>
                            <field name="new_member_month"/>
                            <field name="new_member_from"
                                   invisible="new_member_month != 'range'"
                                   required="new_member_month == 'range'"/>
                            <field name="new_member_to"
                                   invisible="new_member_month != 'range'"
                                   required="new_member_month == 'range'"/>
                        </group>
                        <group>
                            <field name="new_member_photos"/>
                            <field name="new_member_manual" readonly="1"
                                   string="New Members: curated"/>
                            <field name="in_memoriam_manual" readonly="1"
                                   string="In Memoriam: curated"/>
                        </group>
                    </group>
                    <div class="text-muted" style="margin:2px 0 8px;">
                        Tip: use the <b>New Members…</b> and <b>In Memoriam…</b>
                        buttons in the toolbar above to choose exactly who
                        appears in those blocks — they open pre-filled with the
                        automatic list so you can deselect or add people. The
                        two "curated" boxes just show whether you've customized
                        each block (unchecked = fully automatic).
                    </div>
                    <separator string="Newsletter"/>
                    <field name="mailing_model_id" invisible="1"/>
                    <field name="body_html" invisible="1"/>
                    <field name="body_arch" widget="mass_mailing_html"
                           options="{'inline_field': 'body_html'}"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ====== New Members picker (dialog opened from the editor) ====== -->
    <record id="view_elks_bulletin_new_member_wizard_form" model="ir.ui.view">
        <field name="name">elks.bulletin.new.member.wizard.form</field>
        <field name="model">elks.bulletin.new.member.wizard</field>
        <field name="arch" type="xml">
            <form string="New Members — Choose Who Appears">
                <field name="issue_id" invisible="1"/>
                <div class="text-muted" style="margin-bottom:8px;">
                    This list is pre-filled with the members the block would show
                    automatically (by initiation date). Remove anyone you don't
                    want, or add others. Apply to use exactly this list; use
                    <b>Reset to Automatic</b> to go back to the date-based fill.
                    Note: while this curated list is in effect it takes
                    precedence over the block's "Month shown" option and the
                    "New Members Source" setting.
                </div>
                <group>
                    <field name="partner_ids" widget="many2many_tags"
                           options="{'no_create': True}"
                           placeholder="Type a member's name…"/>
                </group>
                <footer>
                    <button string="Apply" name="action_apply" type="object"
                            class="btn-primary"/>
                    <button string="Reset to Automatic" name="action_reset_auto"
                            type="object" class="btn-secondary"/>
                    <button string="Cancel" class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- ====== In Memoriam picker (dialog opened from the editor) ====== -->
    <record id="view_elks_bulletin_in_memoriam_wizard_form" model="ir.ui.view">
        <field name="name">elks.bulletin.in.memoriam.wizard.form</field>
        <field name="model">elks.bulletin.in.memoriam.wizard</field>
        <field name="arch" type="xml">
            <form string="In Memoriam — Choose Who Appears">
                <field name="issue_id" invisible="1"/>
                <div class="text-muted" style="margin-bottom:8px;">
                    This list is pre-filled with the members who passed in the
                    month before this issue. Remove anyone, or add others (a
                    late-reported death, or someone from another month). Apply to
                    use exactly this list; use <b>Reset to Automatic</b> to go
                    back to the date-based fill. Sorted by date of death.
                </div>
                <group>
                    <field name="partner_ids" widget="many2many_tags"
                           options="{'no_create': True}"
                           placeholder="Type a deceased member's name…"/>
                </group>
                <footer>
                    <button string="Apply" name="action_apply" type="object"
                            class="btn-primary"/>
                    <button string="Reset to Automatic" name="action_reset_auto"
                            type="object" class="btn-secondary"/>
                    <button string="Cancel" class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- ============== Newsletter Issue: list ============== -->
    <record id="view_elks_bulletin_issue_list" model="ir.ui.view">
        <field name="name">elks.bulletin.issue.list</field>
        <field name="model">elks.bulletin.issue</field>
        <field name="arch" type="xml">
            <list string="Newsletters">
                <field name="name"/>
                <field name="issue_date"/>
                <field name="issue_ref"/>
                <field name="page_size"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'final'"/>
            </list>
        </field>
    </record>

    <record id="action_elks_bulletin_issue" model="ir.actions.act_window">
        <field name="name">Newsletters</field>
        <field name="res_model">elks.bulletin.issue</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first newsletter</p>
            <p>New issues start from the default <b>Lodge Newsletter</b> template.</p>
        </field>
    </record>

    <!-- ============== Template: form + list ============== -->
    <record id="view_elks_bulletin_template_form" model="ir.ui.view">
        <field name="name">elks.bulletin.template.form</field>
        <field name="model">elks.bulletin.template</field>
        <field name="arch" type="xml">
            <form string="Newsletter Template">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Template name"/></h1>
                    </div>
                    <group>
                        <field name="is_default"/>
                    </group>
                    <separator string="Layout"/>
                    <field name="mailing_model_id" invisible="1"/>
                    <field name="body_html" invisible="1"/>
                    <field name="body_arch" widget="mass_mailing_html"
                           options="{'inline_field': 'body_html'}"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_elks_bulletin_template_list" model="ir.ui.view">
        <field name="name">elks.bulletin.template.list</field>
        <field name="model">elks.bulletin.template</field>
        <field name="arch" type="xml">
            <list string="Templates">
                <field name="name"/>
                <field name="is_default"/>
            </list>
        </field>
    </record>

    <record id="action_elks_bulletin_template" model="ir.actions.act_window">
        <field name="name">Templates</field>
        <field name="res_model">elks.bulletin.template</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
